      "op": "daypartOf",
      "input": {
        "time": "00:00"
      },
      "expected": "morning"
    },
    {
      "name": "the daypart of 08:59",
      "op": "daypartOf",
      "input": {
        "time": "08:59"
      },
      "expected": "morning"
    },
    {
      "name": "the daypart of 11:59",
      "op": "daypartOf",
      "input": {
        "time": "11:59"
      },
      "expected": "morning"
    },
    {
      "name": "the daypart of 12:00",
      "op": "daypartOf",
      "input": {
        "time": "12:00"
      },
      "expected": "afternoon"
    },
    {
      "name": "the daypart of 13:30",
      "op": "daypartOf",
      "input": {
        "time": "13:30"
      },
      "expected": "afternoon"
    },
    {
      "name": "the daypart of 17:59",
      "op": "daypartOf",
      "input": {
        "time": "17:59"
      },
      "expected": "afternoon"
    },
    {
      "name": "the daypart of 18:00",
      "op": "daypartOf",
      "input": {
        "time": "18:00"
      },
