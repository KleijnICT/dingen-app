      "expected": "09:00"
    },
    {
      "name": "the start of afternoon",
      "op": "startTime",
      "input": {
        "daypart": "afternoon"
      },
      "expected": "13:00"
    },
    {
      "name": "the start of evening",
      "op": "startTime",
      "input": {
        "daypart": "evening"
      },
      "expected": "19:00"
    },
    {
      "name": "the start of no daypart",
      "op": "startTime",
